"""
This is the main ingest Snakefile that orchestrates the full ingest workflow
and defines its default outputs.
"""

configfile: "defaults/config.yaml"


def parse_bool(value):
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() == "true"
    return bool(value)


DEV_MODE = parse_bool(config.get("dev", False))
COMPLETE_GENOMES_ONLY = parse_bool(config.get("entrez_complete_genomes_only", False))
SUBSET_ACTIVE_NCBI = DEV_MODE or COMPLETE_GENOMES_ONLY

if not workflow.overwrite_configfiles:
    print("No config provided, using defaults/config.yaml.")

print(f"INGEST DEVELOPMENT MODE: {'ON' if DEV_MODE else 'OFF'}")

if COMPLETE_GENOMES_ONLY:
    print("ENTREZ COMPLETE-GENOME FILTER: ON")
    if not DEV_MODE:
        print("Development mode is OFF, so all complete-genome Entrez matches will be fetched.")

# Default ingest outputs used downstream by phylogenetics and exploratory.
rule all:
    input:
        "results/aligned.fasta",
        "results/sequences.fasta",
        "results/metadata.tsv",

# Core ingest steps.
include: "rules/fetch_from_ncbi.smk"
include: "rules/curate.smk"

# Nextclade alignment and annotations are merged into the final ingest outputs.
include: "rules/nextclade.smk"

# Optional local extensions or overrides.
if "custom_rules" in config:
    for rule_file in config["custom_rules"]:

        # Resolve custom rule paths relative to the analysis directory.
        include: os.path.join(os.getcwd(), rule_file)
