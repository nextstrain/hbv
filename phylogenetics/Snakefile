"""
HBV phylogenetics workflow.

Expected ingest inputs:
- ../ingest/results/sequences.fasta
- ../ingest/results/metadata.tsv
- ../ingest/results/aligned.fasta
"""
from os.path import join
configfile: "defaults/nextstrain/config_nextstrain.yaml"

def parse_bool(value):
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() == "true"
    return bool(value)


VERBOSE = parse_bool(config.get("verbose", False))
DEV_MODE = parse_bool(config.get("dev", False))

if not workflow.overwrite_configfiles and VERBOSE:
    print(
        "No config provided, using defaults/nextstrain/config_nextstrain.yaml.\n"
        "For nextclade workflow run: snakemake --configfile defaults/nextclade/config_nextclade.yaml"
    )

if DEV_MODE and VERBOSE:
    print("DEVELOPMENT MODE ENABLED. CHANGE IN CONFIG FILE")

GENE_MASKS = config["gene_mask"]
ANCESTRAL_GENES = config["ancestral_genes"]["dev"] if DEV_MODE else config["ancestral_genes"]["prod"]

# Keep development runs small and consistent across stitched, single-clade,
# and basic tree builds.
DEV_TREE_GENOTYPES = ["A", "C", "D"]
ALL_GTS = DEV_TREE_GENOTYPES if DEV_MODE else config["all_genotypes"]
SINGLE_BUILD_GENOTYPES = DEV_TREE_GENOTYPES if DEV_MODE else config["single_build_genotypes"]

MODES = ["basic", "stitched", "single-clade"]

RESULTS = join("results", config["workflow"])
STITCHED_DIR = RESULTS + "/stitched/{gene}_global"

# Nextclade:

wf = config.get("workflow")
if wf == "nextclade":
    DATASET_DIR = join(
        "../nextclade_datasets/references",
        config["reference"]["id"],
        "versions",
        config["version"],
        config["nextclade_buildname"],
        ""
    )

    DATASET_FILES = [
        "pathogen.json",
        "sequences.fasta",
        "genome_annotation.gff3",
        "README.md",
        "CHANGELOG.md",
        "tree.json",
        "reference.fasta"
    ]

# Development mode also builds a small set of single-clade and full-tree targets.
single_clade_targets = (
    expand("auspice_datasets/{gene}_masked/clade_{key}.json", gene=GENE_MASKS, key=SINGLE_BUILD_GENOTYPES)
    if DEV_MODE
    else []
)

full_tree_target = (
    expand("auspice_datasets/{gene}_masked/full-tree.json", gene=GENE_MASKS)
    if DEV_MODE
    else []
)

# Define top-level targets for the selected workflow mode.
if wf == "nextstrain":
    rule all:
        input:
            main_clades=expand("auspice_datasets/{gene}_masked/main-clades.json", gene=GENE_MASKS),
            single_clades=single_clade_targets,
            full_tree=full_tree_target

elif wf == "nextclade":
    rule all:
        input:
            datasets=expand(DATASET_DIR + "{file}", file=DATASET_FILES),
            tests=expand(DATASET_DIR + "test_output")

else:
    raise ValueError(f"Unknown workflow: {wf}")

# Length filtering, other filter steps that specifcy the different builds, and gene masking
include: "rules/filter_and_masking.smk"
# Augur tree, pruning problematic clades, refinement and ancestral reconstruction
include: "rules/generating_tree.smk"
# For "stitched" builds only: Collecting, and stitching single genotype trees, again refining and ancestral reconstruction
include: "rules/stitching_workflow.smk"
# Assignment of clades and subclades (also for internal nodes)
include: "rules/clade_assignment.smk"
# Augur export and creating auspice datasets
include: "rules/export_and_auspice_view.smk"
# Generates Nextclade dataset (if nextclade config is used)
if config.get("workflow") == "nextclade":
    include: "rules/nextclade_dataset.smk"

rule clean:
    params:
        paths=[RESULTS]
    shell:
        "rm -rfv {params.paths}"

rule cleanall:
    params:
        paths=["results", "auspice_datasets", "data"]
    shell:
        "rm -rfv {params.paths}"

